@@ -0,0 +1,82 @@
+package app.gamenative.dealers
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.ColorFilter
+import android.graphics.Paint
+import android.graphics.PixelFormat
+import android.graphics.Rect
+import android.graphics.drawable.Drawable
+
+/**
+ * 牌匾底图（assets/dealer/ui/plaque.png，透明底）的九宫格绘制，
+ * 用来当按钮背景：四角云纹不变形，中间随文字长度拉伸。
+ */
+class PlaqueDrawable(private val bitmap: Bitmap) : Drawable() {
+
+    private val paint = Paint(Paint.FILTER_BITMAP_FLAG or Paint.ANTI_ALIAS_FLAG or Paint.DITHER_FLAG)
+
+    override fun draw(canvas: Canvas) {
+        val b = bounds
+        if (b.width() <= 0 || b.height() <= 0) return
+        val srcW = bitmap.width
+        val srcH = bitmap.height
+        val insetSrc = (srcH / 3).coerceAtMost(srcW / 3).coerceAtLeast(1)
+        val insetDst = (b.height() / 3).coerceAtLeast(1)
+
+        val srcL = 0
+        val srcR = srcW - insetSrc
+        val srcT = 0
+        val srcB = srcH - insetSrc
+        val dstL = b.left
+        val dstR = b.right - insetDst
+        val dstT = b.top
+        val dstB = b.bottom - insetDst
+
+        val srcRect = Rect()
+        val dstRect = Rect()
+
+        fun slice(sx: Int, sy: Int, sw: Int, sh: Int, dx: Int, dy: Int, dw: Int, dh: Int) {
+            if (sw <= 0 || sh <= 0 || dw <= 0 || dh <= 0) return
+            srcRect.set(sx, sy, sx + sw, sy + sh)
+            dstRect.set(dx, dy, dx + dw, dy + dh)
+            canvas.drawBitmap(bitmap, srcRect, dstRect, paint)
+        }
+
+        // 四角
+        slice(0, 0, insetSrc, insetSrc, dstL, dstT, insetDst, insetDst)
+        slice(srcR, 0, insetSrc, insetSrc, dstR, dstT, b.right - dstR, insetDst)
+        slice(0, srcB, insetSrc, insetSrc, dstL, dstB, insetDst, b.bottom - dstB)
+        slice(srcR, srcB, insetSrc, insetSrc, dstR, dstB, b.right - dstR, b.bottom - dstB)
+
+        // 四边
+        slice(insetSrc, 0, srcR - insetSrc, insetSrc, dstL + insetDst, dstT, dstR - dstL - insetDst, insetDst)
+        slice(insetSrc, srcB, srcR - insetSrc, insetSrc, dstL + insetDst, dstB, dstR - dstL - insetDst, b.bottom - dstB)
+        slice(0, insetSrc, insetSrc, srcB - insetSrc, dstL, dstT + insetDst, insetDst, dstB - dstT - insetDst)
+        slice(srcR, insetSrc, insetSrc, srcB - insetSrc, dstR, dstT + insetDst, b.right - dstR, dstB - dstT - insetDst)
+
+        // 中心
+        slice(insetSrc, insetSrc, srcR - insetSrc, srcB - insetSrc, dstL + insetDst, dstT + insetDst, dstR - dstL - insetDst, dstB - dstT - insetDst)
+    }
+
+    override fun setAlpha(alpha: Int) {
+        paint.alpha = alpha
+    }
+
+    override fun setColorFilter(colorFilter: ColorFilter?) {
+        paint.colorFilter = colorFilter
+    }
+
+    @Deprecated("Deprecated in Java")
+    override fun getOpacity(): Int = PixelFormat.TRANSLUCENT
+
+    companion object {
+        /** 读内置底图；没有就返回 null，调用方回退到纯色胶囊 */
+        fun load(context: Context): PlaqueDrawable? = runCatching {
+            context.assets.open("dealer/ui/plaque.png").use { input ->
+                PlaqueDrawable(android.graphics.BitmapFactory.decodeStream(input))
+            }
+        }.getOrNull()
+    }
+}
