diff --git a/app/src/main/java/app/gamenative/dealers/DealerBoot.kt b/app/src/main/java/app/gamenative/dealers/DealerBoot.kt
new file mode 100644
index 0000000..7c0f53f
--- /dev/null
+++ b/app/src/main/java/app/gamenative/dealers/DealerBoot.kt
@@ -0,0 +1,284 @@
+package app.gamenative.dealers
+
+import android.content.Context
+import android.net.Uri
+import app.gamenative.PrefManager
+import app.gamenative.data.LibraryItem
+import app.gamenative.utils.ContainerUtils
+import app.gamenative.utils.CustomGameScanner
+import app.gamenative.utils.ManifestComponentHelper
+import app.gamenative.utils.ManifestEntry
+import app.gamenative.utils.ManifestInstaller
+import com.winlator.contents.ContentProfile
+import com.winlator.container.Container
+import timber.log.Timber
+import java.io.File
+import java.util.zip.ZipInputStream
+
+/**
+ * 荷官骰子 / Dealer's Dice —— 单入口引导逻辑。
+ *
+ * 目标：装机即玩。第一次启动把内置的游戏与兼容层落到应用私有目录，建好容器与快捷方式，
+ * 之后每次启动直接进游戏，不再经过任何商店/设置界面。
+ *
+ * 运行栈：Proton 11.0-2 ARM64EC (Wine) + FEXCore（x86-64 翻译），渲染走 Unity 原生 Vulkan
+ * （启动参数 -force-vulkan），不启用 DXVK/VKD3D，也不启用 Box64/WOWBox64。
+ */
+object DealerBoot {
+
+    /** 游戏目录名（自定义游戏标识） */
+    const val FOLDER_NAME = "DealersDice"
+
+    /** 展示名 */
+    const val GAME_LABEL = "荷官骰子"
+
+    /** 主程序 */
+    const val EXE_NAME = "Dealer's Dice.exe"
+
+    /** Unity 原生 Vulkan 渲染：跳过 D3D12 → Vulkan 的翻译层 */
+    const val VULKAN_ARG = "-force-vulkan"
+
+    /** 内置的 Proton 包（assets/dealer/proton-11.0-2-arm64ec.wcp） */
+    private const val PROTON_FILE = "proton-11.0-2-arm64ec.wcp"
+
+    /** 内置的 FEXCore 包（assets/dealer/FEXCore-2611-gn-7.wcp） */
+    private const val FEX_FILE = "FEXCore-2611-gn-7.wcp"
+
+    const val PROTON_ID = "proton-11.0-2-arm64ec-1"
+    const val FEX_ID = "2611-gn-7-0"
+
+    private const val PROGRESS_EXTRACT = 0.55f
+
+    /** 帧率档位（0 = 不限帧） */
+    val FPS_CAPS = listOf(0, 30, 45, 60, 90, 120)
+
+    fun gameDir(context: Context): File =
+        File(context.getExternalFilesDir(null), "custom_games/$FOLDER_NAME")
+
+    private fun markerFile(context: Context): File = File(context.filesDir, ".dealer_ready")
+
+    /**
+     * 按设备真实分辨率推导出的缩放分辨率候选。首位永远是设备原生尺寸。
+     * 竖屏数值统一成宽 > 高的横向尺寸，因为游戏是横屏。
+     */
+    fun resolutionOptions(context: Context): List<String> {
+        val dm = context.resources.displayMetrics
+        val longSide = maxOf(dm.widthPixels, dm.heightPixels)
+        val shortSide = minOf(dm.widthPixels, dm.heightPixels)
+
+        val out = LinkedHashSet<String>()
+        out.add("${longSide}x${shortSide}")
+
+        // 同宽高比的等比缩放档
+        for (scale in listOf(0.75f, 0.66f, 0.5f)) {
+            val w = even(longSide * scale)
+            val h = even(shortSide * scale)
+            if (w >= 1280) out.add("${w}x${h}")
+        }
+
+        // 常见 16:9 / 16:10 档位：只在不超过设备原生长边时提供
+        for ((w, h) in listOf(2560 to 1440, 1920 to 1080, 1600 to 900, 1280 to 720)) {
+            if (w <= longSide) out.add("${w}x${h}")
+        }
+        return out.toList()
+    }
+
+    private fun even(v: Float): Int {
+        val i = v.toInt()
+        return if (i % 2 == 0) i else i - 1
+    }
+
+    fun savedResolution(context: Context): String? = PrefManager.dealerScreenSize
+
+    fun saveResolution(context: Context, value: String) {
+        PrefManager.dealerScreenSize = value
+    }
+
+    /** 是否已经初始化过（游戏已解包、容器已建好） */
+    fun isReady(context: Context): Boolean = markerFile(context).isFile()
+
+    /**
+     * 把内置的游戏与兼容层落盘，并返回可启动的 appId。
+     * 幂等：已初始化过的机器只做轻量校验。
+     */
+    suspend fun ensureReady(context: Context, onProgress: (Float, String) -> Unit): String {
+        onProgress(0f, "准备中")
+
+        val dir = gameDir(context)
+        if (!isReady(context) || !dir.isDirectory) {
+            dir.mkdirs()
+            onProgress(0.02f, "解压游戏")
+            extractGame(context, dir) { p ->
+                onProgress(p * PROGRESS_EXTRACT, "解压游戏 ${(p * 100).toInt()}%")
+            }
+        }
+
+        onProgress(0.6f, "注册游戏")
+        val folders = PrefManager.customGameManualFolders.toMutableSet()
+        folders.add(dir.absolutePath)
+        PrefManager.customGameManualFolders = folders
+        CustomGameScanner.invalidateCache()
+
+        val item: LibraryItem? = CustomGameScanner.createLibraryItemFromFolder(dir.absolutePath)
+        val appId = item?.appId?.takeIf { it.isNotEmpty() }
+            ?: run {
+                // 扫描器没认出时退化为固定 id，仍能挂在自定义游戏容器上
+                "CUSTOM_GAME_1"
+            }
+        Timber.i("DealerBoot: appId=$appId dir=${dir.absolutePath}")
+
+        onProgress(0.65f, "安装兼容层")
+        installComponents(context) { p -> onProgress(0.65f + p * 0.3f, "安装兼容层 ${(p * 100).toInt()}%") }
+
+        onProgress(0.97f, "配置容器")
+        // 安装后按实际落盘的版本标识回填，避免写死字符串与镜像不一致
+        val installedNow = runCatching {
+            ManifestComponentHelper.loadInstalledContentLists(context)
+        }.getOrNull()
+        val wineVersion = installedNow?.installed?.proton
+            ?.firstOrNull { it.contains("11.0-2") }
+            ?: "proton-11.0-2-arm64ec"
+        val fexVersion = installedNow?.installed?.fexcore
+            ?.firstOrNull { it.contains("2611") }
+            ?: FEX_ID
+
+        val container = ContainerUtils.getOrCreateContainer(context, appId)
+        applyContainerConfig(context, container, wineVersion, fexVersion)
+
+        markerFile(context).parentFile?.mkdirs()
+        markerFile(context).writeText(appId)
+        onProgress(1f, "完成")
+        return appId
+    }
+
+    private fun extractGame(context: Context, dir: File, onProgress: (Float) -> Unit) {
+        val assetName = "dealer/game.zip"
+        val total = runCatching { context.assets.open(assetName).use { it.available() } }.getOrDefault(0)
+        var read = 0
+        var last = -1
+        ZipInputStream(context.assets.open(assetName).buffered()).use { zis ->
+            var entry = zis.nextEntry
+            while (entry != null) {
+                val out = File(dir, entry.name)
+                if (entry.isDirectory) {
+                    out.mkdirs()
+                } else {
+                    out.parentFile?.mkdirs()
+                    out.outputStream().use { os ->
+                        val buf = ByteArray(1 shl 16)
+                        while (true) {
+                            val n = zis.read(buf)
+                            if (n <= 0) break
+                            os.write(buf, 0, n)
+                            read += n
+                            if (total > 0) {
+                                val p = (read.toFloat() / total).coerceIn(0f, 1f)
+                                val bucket = (p * 100).toInt()
+                                if (bucket != last) {
+                                    last = bucket
+                                    onProgress(p)
+                                }
+                            }
+                        }
+                    }
+                }
+                zis.closeEntry()
+                entry = zis.nextEntry
+            }
+        }
+        onProgress(1f)
+    }
+
+    /** 安装 Proton + FEXCore：命中内置包时完全离线，不访问网络 */
+    private suspend fun installComponents(context: Context, onProgress: (Float) -> Unit) {
+        val installed = runCatching {
+            ManifestComponentHelper.loadInstalledContentLists(context)
+        }.getOrNull()
+
+        val protonMissing = installed?.installed?.proton?.none { it.contains("11.0-2") } ?: true
+        val fexMissing = installed?.installed?.fexcore?.none { it.contains("2611") } ?: true
+
+        if (protonMissing) {
+            onProgress(0.05f)
+            ManifestInstaller.installManifestEntry(
+                context = context,
+                entry = ManifestEntry(
+                    id = PROTON_ID,
+                    name = "Proton 11.0-2 ARM64ec",
+                    url = "https://downloads.gamenative.app/$PROTON_FILE",
+                ),
+                isDriver = false,
+                contentType = ContentProfile.ContentType.CONTENT_TYPE_PROTON,
+                onProgress = { p -> onProgress(0.05f + p * 0.65f) },
+            )
+        }
+
+        if (fexMissing) {
+            onProgress(0.75f)
+            ManifestInstaller.installManifestEntry(
+                context = context,
+                entry = ManifestEntry(
+                    id = FEX_ID,
+                    name = "FEX 2611-gn",
+                    url = "https://downloads.gamenative.app/$FEX_FILE",
+                ),
+                isDriver = false,
+                contentType = ContentProfile.ContentType.CONTENT_TYPE_FEXCORE,
+                onProgress = { p -> onProgress(0.75f + p * 0.2f) },
+            )
+        }
+        onProgress(1f)
+    }
+
+    /** 写死运行栈：原生 Vulkan、只留 FEX、容器内 vblank 关掉 */
+    fun applyContainerConfig(
+        context: Context,
+        container: Container,
+        wineVersion: String = "proton-11.0-2-arm64ec",
+        fexVersion: String = FEX_ID,
+    ) {
+        val data = ContainerUtils.toContainerData(container)
+
+        // 环境变量是空格分隔的 "K=V K=V"
+        val envVars = buildString {
+            append(data.envVars.ifEmpty { Container.DEFAULT_ENV_VARS })
+            if (!contains("PROTON_USE_WINED3D")) append(" PROTON_USE_WINED3D=0")
+            if (!contains("vblank_mode")) append(" vblank_mode=0")
+        }
+
+        val ours = data.copy(
+            name = GAME_LABEL,
+            screenSize = PrefManager.dealerScreenSize ?: resolutionOptions(context).first(),
+            envVars = envVars,
+            execArgs = VULKAN_ARG,
+            executablePath = EXE_NAME,
+            wineVersion = wineVersion,
+            fexcoreVersion = fexVersion,
+            box64Version = "",
+            dxwrapperConfig = "version=;vkd3dVersion=;framerate=0",
+            showFPS = true,
+        )
+        ContainerUtils.applyToContainer(context, container, ours)
+
+        container.putExtra("fpsLimiterEnabled", PrefManager.dealerFpsCap > 0)
+        container.putExtra("fpsLimiterTarget", PrefManager.dealerFpsCap)
+    }
+
+    /** 首次进入时把 HUD 设成"只显示帧率、居中、小号" */
+    fun applyHudPrefs() {
+        PrefManager.showFps = true
+        PrefManager.performanceHudShowFrameRate = true
+        PrefManager.performanceHudShowCpuUsage = false
+        PrefManager.performanceHudShowGpuUsage = false
+        PrefManager.performanceHudShowRamUsage = false
+        PrefManager.performanceHudShowBatteryLevel = false
+        PrefManager.performanceHudShowPowerDraw = false
+        PrefManager.performanceHudShowBatteryTemperature = false
+        PrefManager.performanceHudShowCpuTemperature = false
+        PrefManager.performanceHudShowGpuTemperature = false
+        PrefManager.performanceHudShowBottleneck = false
+        PrefManager.performanceHudShowFrameRateGraph = false
+    }
+
+    fun uriOf(file: File): Uri = Uri.fromFile(file)
+}
