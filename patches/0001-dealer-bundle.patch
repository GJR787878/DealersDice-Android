+package app.gamenative.dealers
+
+import android.content.Context
+import timber.log.Timber
+import java.io.File
+
+/**
+ * 内置 payload：把兼容层与容器模板随包发出去，首次启动直接落盘，
+ * 不依赖 downloads.gamenative.app 的可用性。
+ *
+ * 目录：assets/dealer/payload/<原文件名>
+ */
+object LocalPayload {
+
+    private const val DIR = "dealer/payload"
+
+    fun has(context: Context, fileName: String): Boolean = runCatching {
+        context.assets.open("$DIR/$fileName").close()
+        true
+    }.getOrDefault(false)
+
+    /** 命中内置 payload 时拷贝到 dest 并返回 true；否则返回 false 交由上层走网络 */
+    fun copyFromAssets(
+        context: Context,
+        fileName: String,
+        dest: File,
+        onProgress: (Float) -> Unit = {},
+    ): Boolean {
+        if (fileName.isEmpty() || !has(context, fileName)) return false
+        return try {
+            dest.parentFile?.mkdirs()
+            val tmp = File(dest.absolutePath + ".part")
+            context.assets.open("$DIR/$fileName").use { input ->
+                tmp.outputStream().use { out ->
+                    val buf = ByteArray(1 shl 16)
+                    var total = 0L
+                    while (true) {
+                        val n = input.read(buf)
+                        if (n <= 0) break
+                        out.write(buf, 0, n)
+                        total += n
+                        onProgress(((total % 8_000_000L) / 8_000_000f).coerceIn(0f, 1f))
+                    }
+                }
+            }
+            if (tmp.length() <= 0L) {
+                tmp.delete()
+                false
+            } else {
+                if (dest.exists()) dest.delete()
+                tmp.renameTo(dest)
+                onProgress(1f)
+                Timber.i("LocalPayload: $fileName 来自内置 assets")
+                true
+            }
+        } catch (e: Exception) {
+            Timber.w(e, "LocalPayload: 读取内置 $fileName 失败")
+            false
+        }
+    }
+}
