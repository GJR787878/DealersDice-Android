+package app.gamenative.dealers
+
+import android.content.Context
+import android.graphics.Color
+import android.graphics.drawable.GradientDrawable
+import android.os.SystemClock
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.widget.FrameLayout
+import android.widget.LinearLayout
+import android.widget.TextView
+import app.gamenative.PluviaApp
+import app.gamenative.PrefManager
+import com.winlator.xenvironment.components.XServerComponent
+import com.winlator.xserver.XKeycode
+
+/**
+ * 游戏画面之上的极简覆盖层：
+ *  - 左上角「菜单」= 发送 ESC 想游戏
+ *  - 左上角「帧率」= 循环切档（不限 / 30 / 45 / 60 / 90 / 120）
+ * 帧数显示用容器自带的性能 HUD（已固定在屏幕中间，只显示帧率）。
+ */
+class DealerOverlayView(context: Context) : LinearLayout(context) {
+
+    private val menuButton: TextView = capsule(context, "菜单")
+    private val fpsButton: TextView = capsule(context, "帧率")
+    private var lastPress = 0L
+
+    init {
+        orientation = HORIZONTAL
+        gravity = Gravity.TOP or Gravity.START
+        isClickable = false
+        val pad = dp(context, 8)
+        setPadding(pad, pad, pad, pad)
+
+        addView(menuButton, rowParams())
+        addView(fpsButton, rowParams())
+        refreshFpsLabel()
+
+        menuButton.setOnClickListener { sendEscape() }
+        fpsButton.setOnClickListener { cycleFrameCap() }
+    }
+
+    fun attachTo(host: FrameLayout) {
+        val lp = FrameLayout.LayoutParams(
+            FrameLayout.LayoutParams.WRAP_CONTENT,
+            FrameLayout.LayoutParams.WRAP_CONTENT,
+        ).apply {
+            gravity = Gravity.TOP or Gravity.START
+            leftMargin = dp(context, 6)
+            topMargin = dp(context, 6)
+        }
+        host.addView(this, lp)
+        bringToFront()
+    }
+
+    private fun sendEscape() {
+        val now = SystemClock.uptimeMillis()
+        if (now - lastPress < 250) return
+        lastPress = now
+        val xServer = PluviaApp.xEnvironment
+            ?.getComponent(XServerComponent::class.java)
+            ?.xServer
+            ?: return
+        runCatching {
+            xServer.injectKeyPress(XKeycode.KEY_ESC)
+            postDelayed({ runCatching { xServer.injectKeyRelease(XKeycode.KEY_ESC) } }, 80)
+        }
+    }
+
+    private fun cycleFrameCap() {
+        val current = PrefManager.dealerFpsCap
+        val idx = DealerBoot.FPS_CAPS.indexOf(current).let { if (it < 0) 0 else it }
+        val next = DealerBoot.FPS_CAPS[(idx + 1) % DealerBoot.FPS_CAPS.size]
+        PrefManager.dealerFpsCap = next
+        PluviaApp.xServerView?.setFrameRateLimit(next)
+        refreshFpsLabel()
+    }
+
+    private fun refreshFpsLabel() {
+        val cap = PrefManager.dealerFpsCap
+        fpsButton.text = if (cap == 0) "帧率 不限" else "帧率 $cap"
+    }
+
+    private fun rowParams(): LayoutParams = LayoutParams(
+        LayoutParams.WRAP_CONTENT,
+        LayoutParams.WRAP_CONTENT,
+    ).apply { rightMargin = dp(context, 8) }
+
+    private companion object {
+        fun dp(context: Context, value: Int): Int = TypedValue.applyDimension(
+            TypedValue.COMPLEX_UNIT_DIP, value.toFloat(), context.resources.displayMetrics,
+        ).toInt()
+
+        fun capsule(context: Context, label: String): TextView = TextView(context).apply {
+            text = label
+            setTextColor(Color.WHITE)
+            textSize = 13f
+            gravity = Gravity.CENTER
+            val padH = dp(context, 14)
+            val padV = dp(context, 6)
+            setPadding(padH, padV, padH, padV)
+            background = GradientDrawable().apply {
+                cornerRadius = dp(context, 22).toFloat()
+                setColor(0xCC1C1C1E.toInt())
+                setStroke(dp(context, 1), 0x66FFFFFF)
+            }
+            isClickable = true
+            isFocusable = true
+            alpha = 0.92f
+        }
+    }
+}
+
+/** 把覆盖层挂到 Activity 最上层（在 Compose 内容之上） */
+fun attachDealerOverlay(activity: android.app.Activity) {
+    val decor = activity.window?.decorView as? FrameLayout ?: return
+    if (decor.findViewWithTag<View>("dealer_overlay") != null) return
+    val overlay = DealerOverlayView(activity)
+    overlay.tag = "dealer_overlay"
+    overlay.attachTo(decor)
+}
