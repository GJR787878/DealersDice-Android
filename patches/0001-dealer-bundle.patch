+package app.gamenative.dealers
+
+/**
+ * 荷官骰子：全局交互策略。
+ *
+ * 只用触屏，不出现任何模拟器自带的虚拟手柄 / 输入法图标 / 浮层控件；
+ * 触摸由 [DealerTouch] 自己翻译成鼠标事件。
+ */
+object DealerUi {
+    /** 纯触屏模式：屏蔽虚拟手柄与模拟器自带的触摸板逻辑 */
+    const val TOUCH_ONLY = true
+
+    /** 长按判定（毫秒），超过且手指没明显移动即为长按 → 右键 */
+    const val LONG_PRESS_MS = 420L
+
+    /** 判定"还在同一个点"的像素容差（dp） */
+    const val TAP_SLOP_DP = 10f
+}
